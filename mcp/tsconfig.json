{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": "..",
    "paths": {
      // The bundle swaps the browser Supabase client for the Node one; mirror that
      // here so type-checking sees exactly what ships.
      "@/lib/supabase/client": ["./mcp/src/supabaseClient.ts"],
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": ["src"]
}
